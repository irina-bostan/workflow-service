# Copy to ui/.env and fill in the values for your environment.
# These are read at bundle time by Expo SDK 49+ as `process.env.EXPO_PUBLIC_*`.

# ─── API endpoints ────────────────────────────────────────────────────────────
# Leave unset for local dev; the client falls back to the platform-aware loopback
# (iOS simulator → http://localhost:8080, Android emulator → http://10.0.2.2:8080).
# Set explicitly for stage / prod, e.g. https://api.stage.techquarter.com
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_COGNITO_URL=

# ─── Cognito-local credentials ────────────────────────────────────────────────
# Pulled from local/.cognito/db/clients.json — re-run local/setup-cognito.sh
# whenever the local pool is recreated, then update CLIENT_ID below.
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_USERNAME=tester@techquarter.local
EXPO_PUBLIC_COGNITO_PASSWORD=Test1234!
